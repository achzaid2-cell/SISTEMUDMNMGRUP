{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*, geolocation=*, fullscreen=*"
        },
        {
          "key": "Feature-Policy",
          "value": "camera *; microphone *; geolocation *; fullscreen *"
        }
      ]
    }
  ]
}
